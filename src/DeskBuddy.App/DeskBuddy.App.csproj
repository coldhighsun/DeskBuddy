<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>DeskBuddy</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <Product>DeskBuddy</Product>
    <Description>A desktop pet for work computers.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DeskBuddy.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <!--
      Tiered compilation off: the runtime otherwise keeps re-compiling the code the pet runs every few milliseconds. Idle
      Release build, first minute after start (two runs each): about 9.6 s of CPU with it on against about 5.9 s with it
      off, and about 20 MB more working set (about 206 MB against 184 MB). Code runs fully optimised from its first call.
      ReadyToRun was measured earlier and did not add anything on top of this.
    -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeskBuddy.Application\DeskBuddy.Application.csproj" />
    <ProjectReference Include="..\DeskBuddy.Infrastructure\DeskBuddy.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\DeskBuddy.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\skins\**\*" Link="skins\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
