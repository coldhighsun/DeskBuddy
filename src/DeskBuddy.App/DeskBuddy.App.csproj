<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      Tiered compilation off: the runtime otherwise keeps re-compiling the code the pet runs every few milliseconds, which
      measured as about 6 s of CPU in the first minute against under 2 s with it off. Code runs fully optimised from its
      first call; start-up time is unchanged. ReadyToRun was measured too and did not add anything on top of this.
    -->
    <TieredCompilation>false</TieredCompilation>
    <!-- WPF0001: the Fluent theme (Window.ThemeMode) is still marked experimental in WPF. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeskBuddy.Application\DeskBuddy.Application.csproj" />
    <ProjectReference Include="..\DeskBuddy.Infrastructure\DeskBuddy.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\skins\**\*" Link="skins\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
