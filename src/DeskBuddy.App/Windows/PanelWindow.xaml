<Window x:Class="DeskBuddy.App.Windows.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:DeskBuddy.App.Resources"
        Title="{x:Static res:Strings.AppName}"
        Icon="pack://application:,,,/DeskBuddy;component/Assets/DeskBuddy.ico"
        Width="460"
        Height="560"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

        <!-- A TextBlock that is collapsed while its text is empty, for optional error messages. -->
        <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid DataContext="{Binding Settings}" IsEnabled="{Binding IsEditable}" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding LoadFailureMessage}"
                       Style="{StaticResource ErrorTextStyle}"
                       AutomationProperties.AutomationId="SettingsLoadError" />
            <TextBlock Text="{Binding SaveError}"
                       Style="{StaticResource ErrorTextStyle}"
                       AutomationProperties.AutomationId="SettingsSaveError" />
        </StackPanel>

        <TabControl x:Name="Tabs" Grid.Row="1" Margin="0,6,0,0" SelectedIndex="0">
            <TabItem Header="{x:Static res:Strings.TabPets}"
                     AutomationProperties.AutomationId="PetsTab"
                     DataContext="{Binding DataContext.Pets, RelativeSource={RelativeSource AncestorType=Window}}">
                <Grid Margin="12,12,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{x:Static res:Strings.PetsEmpty}"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}"
                                   Opacity="0.65"
                                   TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Cards}" AutomationProperties.AutomationId="PetCards">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="176"
                                            Height="330"
                                            Margin="0,0,8,8"
                                            Padding="10"
                                            BorderThickness="2"
                                            CornerRadius="6"
                                            Background="Transparent"
                                            MouseLeftButtonUp="OnPetCardMouseLeftButtonUp"
                                            AutomationProperties.AutomationId="{Binding FolderName, StringFormat=PetCard_{0}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource PetCardBorderBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PetCardSelectedBorderBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                        <Setter Property="Cursor" Value="Hand" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                        <Setter Property="Opacity" Value="0.6" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Image Width="96"
                                                   Height="96"
                                                   HorizontalAlignment="Center"
                                                   Source="{Binding CurrentFrame}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Text="{Binding StateCaption}"
                                                       HorizontalAlignment="Center"
                                                       Opacity="0.6"
                                                       FontSize="11"
                                                       MinHeight="16"
                                                       Margin="0,2,0,6" />
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{x:Static res:Strings.PetsCurrent}"
                                                           Foreground="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IsCurrent, Converter={StaticResource BooleanToVisibility}}" />
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding InfoText}"
                                                       Opacity="0.65"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,6" />
                                            <ItemsControl ItemsSource="{Binding Tags}" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,4,4"
                                                                Padding="5,1"
                                                                CornerRadius="3"
                                                                BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                                                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSupported}" Value="False">
                                                                            <Setter Property="Background" Value="Transparent" />
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
                                                                            <Setter Property="Opacity" Value="0.55" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Text}" FontSize="11">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <!-- Unsupported tags keep the themed text color of the window. -->
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSupported}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding LoadError}"
                                                       ToolTip="{Binding LoadError}"
                                                       Style="{StaticResource ErrorTextStyle}"
                                                       MaxHeight="64"
                                                       FontSize="11" />
                                            <!-- The visibility style sits on a wrapper: a style on the Button itself would replace the
                                                 themed button style. Hidden (not collapsed) keeps the card layout steady. -->
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsSelected}" Value="True" />
                                                                    <Condition Binding="{Binding IsCurrent}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Button Content="{x:Static res:Strings.PetsUse}"
                                                        Margin="0,8,0,0"
                                                        Padding="0,7"
                                                        MinHeight="34"
                                                        Style="{DynamicResource AccentButtonStyle}"
                                                        HorizontalAlignment="Stretch"
                                                        Command="{Binding DataContext.UseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.AutomationId="{Binding FolderName, StringFormat=PetUse_{0}}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Grid.Row="1"
                               Text="{Binding PetError}"
                               Style="{StaticResource ErrorTextStyle}"
                               Margin="0,6,12,0"
                               AutomationProperties.AutomationId="PetError" />
                </Grid>
            </TabItem>

            <TabItem Header="{x:Static res:Strings.TabAppearance}" AutomationProperties.AutomationId="AppearanceTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <!-- Appearance -->
                        <TextBlock Text="{x:Static res:Strings.SettingsAppearance}" FontWeight="SemiBold" Margin="0,6,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SettingsPetSize}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Sizes}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedSize}"
                                      AutomationProperties.AutomationId="PetSizeBox" />
                        </Grid>
                        <CheckBox IsChecked="{Binding ClimbEdges}"
                                  Margin="0,8,0,0"
                                  AutomationProperties.Name="{x:Static res:Strings.SettingsClimbEdges}"
                                  AutomationProperties.AutomationId="ClimbEdgesCheck">
                            <TextBlock Text="{x:Static res:Strings.SettingsClimbEdges}" TextWrapping="Wrap" />
                        </CheckBox>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SettingsLanguage}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Languages}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedLanguage}"
                                      AutomationProperties.AutomationId="LanguageBox" />
                        </Grid>
                        <TextBlock Text="{x:Static res:Strings.LanguageRestartHint}" Opacity="0.65" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SettingsTheme}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Themes}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedTheme}"
                                      AutomationProperties.AutomationId="ThemeBox" />
                        </Grid>
                        <TextBlock Text="{x:Static res:Strings.SettingsMode}" Margin="0,10,0,4" />
                        <RadioButton GroupName="Mode"
                                     Content="{x:Static res:Strings.ModeDocked}"
                                     IsChecked="{Binding IsDocked}"
                                     AutomationProperties.AutomationId="ModeDocked" />
                        <RadioButton GroupName="Mode"
                                     Content="{x:Static res:Strings.ModeRoam}"
                                     IsChecked="{Binding IsRoam}"
                                     Margin="0,4,0,0"
                                     AutomationProperties.AutomationId="ModeRoam" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{x:Static res:Strings.TabBehavior}" AutomationProperties.AutomationId="BehaviorTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <!-- Timing -->
                        <TextBlock Text="{x:Static res:Strings.SettingsTiming}" FontWeight="SemiBold" Margin="0,6,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{x:Static res:Strings.SettingsSedentary}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SedentaryText}" KeyDown="OnSettingsTextBoxKeyDown"
                                     AutomationProperties.AutomationId="SedentaryBox" />
                            <TextBlock Grid.Row="1" Text="{x:Static res:Strings.SettingsSleep}" VerticalAlignment="Center" Margin="0,6,0,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SleepText}" KeyDown="OnSettingsTextBoxKeyDown" Margin="0,6,0,0"
                                     AutomationProperties.AutomationId="SleepBox" />
                        </Grid>
                        <TextBlock Text="{Binding TimingError}"
                                   Style="{StaticResource ErrorTextStyle}"
                                   AutomationProperties.AutomationId="TimingError" />


                        <!-- Full screen -->
                        <TextBlock Text="{x:Static res:Strings.SettingsFullscreen}" FontWeight="SemiBold" Margin="0,18,0,6" />
                        <CheckBox Content="{x:Static res:Strings.AutoHide}"
                                  IsChecked="{Binding AutoHideWhenFullscreen}"
                                  AutomationProperties.AutomationId="AutoHideCheck" />
                        <CheckBox Content="{x:Static res:Strings.CoveredMonitor}"
                                  IsChecked="{Binding DetectCoveredMonitor}"
                                  Margin="0,4,0,0"
                                  AutomationProperties.AutomationId="CoveredMonitorCheck" />
                        <TextBlock Text="{x:Static res:Strings.BlacklistLabel}" Margin="0,10,0,4" TextWrapping="Wrap" />
                        <TextBox Text="{Binding BlacklistText}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="70"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 AutomationProperties.AutomationId="BlacklistBox" />


                        <!-- Development -->
                        <TextBlock Text="{x:Static res:Strings.SettingsDev}" FontWeight="SemiBold" Margin="0,18,0,6" />
                        <CheckBox Content="{x:Static res:Strings.DevMode}"
                                  IsChecked="{Binding DevModeEnabled}"
                                  AutomationProperties.AutomationId="DevModeCheck" />
                        <TextBlock Text="{x:Static res:Strings.DevProcessesLabel}" Margin="0,10,0,4" TextWrapping="Wrap" />
                        <TextBox Text="{Binding DevProcessesText}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="70"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 AutomationProperties.AutomationId="DevProcessesBox" />


                        <!-- Scenarios -->
                        <TextBlock Text="{x:Static res:Strings.SettingsScenarios}" FontWeight="SemiBold" Margin="0,18,0,6" />
                        <CheckBox Content="{x:Static res:Strings.ScenariosEnabled}"
                                  IsChecked="{Binding ScenariosEnabled}"
                                  AutomationProperties.AutomationId="ScenariosEnabledCheck" />
                        <ItemsControl ItemsSource="{Binding Scenarios}"
                                      IsEnabled="{Binding ScenariosEnabled}"
                                      Margin="20,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}"
                                              IsChecked="{Binding IsEnabled}"
                                              Margin="0,2,0,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{x:Static res:Strings.MeetingProcessesLabel}" Margin="0,10,0,4" TextWrapping="Wrap" />
                        <TextBox Text="{Binding MeetingProcessesText}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="70"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 AutomationProperties.AutomationId="MeetingProcessesBox" />
                        <TextBlock Text="{x:Static res:Strings.ClockOutTimeLabel}" Margin="0,10,0,4" TextWrapping="Wrap" />
                        <TextBox Text="{Binding ClockOutTimeText}"
                                 Width="70"
                                 HorizontalAlignment="Left"
                                 AutomationProperties.AutomationId="ClockOutTimeBox" />
                        <TextBlock Text="{Binding ClockOutTimeError}"
                                   Style="{StaticResource ErrorTextStyle}"
                                   AutomationProperties.AutomationId="ClockOutTimeError" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{x:Static res:Strings.TabSystem}" AutomationProperties.AutomationId="SystemTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <!-- Boss key -->
                        <TextBlock Text="{x:Static res:Strings.SettingsBossKey}" FontWeight="SemiBold" Margin="0,6,0,6" />
                        <TextBox Text="{Binding BossKeyText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 IsReadOnlyCaretVisible="False"
                                 PreviewKeyDown="OnBossKeyPreviewKeyDown"
                                 HorizontalAlignment="Left"
                                 Width="220"
                                 AutomationProperties.AutomationId="BossKeyBox" />
                        <TextBlock Text="{x:Static res:Strings.BossKeyHint}" Opacity="0.6" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding BossKeyError}"
                                   Style="{StaticResource ErrorTextStyle}"
                                   AutomationProperties.AutomationId="BossKeyError" />


                        <!-- System -->
                        <TextBlock Text="{x:Static res:Strings.SettingsSystem}" FontWeight="SemiBold" Margin="0,18,0,6" />
                        <CheckBox Content="{x:Static res:Strings.AutoStart}"
                                  IsChecked="{Binding AutoStart}"
                                  AutomationProperties.AutomationId="AutoStartCheck" />
                        <TextBlock Text="{Binding AutoStartError}"
                                   Style="{StaticResource ErrorTextStyle}"
                                   AutomationProperties.AutomationId="AutoStartError" />


                        <!-- Diagnostics -->
                        <TextBlock Text="{x:Static res:Strings.SettingsDiagnostics}" FontWeight="SemiBold" Margin="0,18,0,6" />
                        <Button Content="{x:Static res:Strings.OpenLogs}"
                                Command="{Binding OpenLogsCommand}"
                                HorizontalAlignment="Left"
                                Padding="12,4"
                                AutomationProperties.AutomationId="OpenLogsButton" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
