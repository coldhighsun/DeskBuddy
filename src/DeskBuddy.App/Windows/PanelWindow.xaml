<Window x:Class="DeskBuddy.App.Windows.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:DeskBuddy.App.Resources"
        xmlns:pres="clr-namespace:DeskBuddy.App.Presentation"
        Title="{x:Static res:Strings.AppName}"
        Icon="pack://application:,,,/DeskBuddy;component/Assets/DeskBuddy.ico"
        Width="460"
        Height="610"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

        <!-- A TextBlock that is collapsed while its text is empty, for optional messages. -->
        <Style x:Key="OptionalTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- An optional error message. -->
        <Style x:Key="ErrorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource OptionalTextStyle}">
            <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
        </Style>

        <!-- An optional note that is no error. -->
        <Style x:Key="NoticeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource OptionalTextStyle}">
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Window.Resources>

    <Grid DataContext="{Binding Settings}" IsEnabled="{Binding IsEditable}" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding LoadFailureMessage}"
                       Style="{StaticResource ErrorTextStyle}"
                       AutomationProperties.AutomationId="SettingsLoadError" />
            <TextBlock Text="{Binding SaveError}"
                       Style="{StaticResource ErrorTextStyle}"
                       AutomationProperties.AutomationId="SettingsSaveError" />
        </StackPanel>

        <TabControl x:Name="Tabs" Grid.Row="1" Margin="0,6,0,0" SelectedIndex="0">
            <TabItem Header="{x:Static res:Strings.TabPets}"
                     AutomationProperties.AutomationId="PetsTab"
                     DataContext="{Binding DataContext.Pets, RelativeSource={RelativeSource AncestorType=Window}}">
                <Grid Margin="12,12,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{x:Static res:Strings.PetsLoading}"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibility}}"
                                   Opacity="0.65"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Static res:Strings.PetsEmpty}"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}"
                                   Opacity="0.65"
                                   TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Cards}" AutomationProperties.AutomationId="PetCards">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="176"
                                            Height="190"
                                            ToolTip="{Binding Details}"
                                            AutomationProperties.Name="{Binding DisplayName}"
                                            AutomationProperties.HelpText="{Binding Details}"
                                            Margin="0,0,8,8"
                                            Padding="10"
                                            BorderThickness="2"
                                            CornerRadius="6"
                                            Background="Transparent"
                                            MouseLeftButtonUp="OnPetCardMouseLeftButtonUp"
                                            AutomationProperties.AutomationId="{Binding FolderName, StringFormat=PetCard_{0}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource PetCardBorderBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PetCardSelectedBorderBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                        <Setter Property="Cursor" Value="Hand" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                        <Setter Property="Opacity" Value="0.6" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Image Width="96"
                                                   Height="96"
                                                   HorizontalAlignment="Center"
                                                   Source="{Binding CurrentFrame}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Text="{Binding StateCaption}"
                                                       HorizontalAlignment="Center"
                                                       Opacity="0.6"
                                                       FontSize="11"
                                                       MinHeight="16"
                                                       Margin="0,2,0,6" />
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{x:Static res:Strings.PetsCurrent}"
                                                           Foreground="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IsCurrent, Converter={StaticResource BooleanToVisibility}}" />
                                                <!-- The name is in the tooltip; a pet that could not be loaded has no tooltip, so it shows it. -->
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                            <TextBlock Text="{Binding LoadError}"
                                                       ToolTip="{Binding LoadError}"
                                                       Style="{StaticResource ErrorTextStyle}"
                                                       MaxHeight="64"
                                                       FontSize="11" />
                                            <!-- The visibility style sits on a wrapper: a style on the Button itself would replace the
                                                 themed button style. Hidden (not collapsed) keeps the card layout steady. -->
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsSelected}" Value="True" />
                                                                    <Condition Binding="{Binding IsCurrent}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Button Content="{x:Static res:Strings.PetsUse}"
                                                        Margin="0,8,0,0"
                                                        Padding="0,7"
                                                        MinHeight="34"
                                                        Style="{DynamicResource AccentButtonStyle}"
                                                        HorizontalAlignment="Stretch"
                                                        Command="{Binding DataContext.UseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.AutomationId="{Binding FolderName, StringFormat=PetUse_{0}}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Grid.Row="1"
                               Text="{Binding PetError}"
                               Style="{StaticResource ErrorTextStyle}"
                               Margin="0,6,12,0"
                               AutomationProperties.AutomationId="PetError" />
                </Grid>
            </TabItem>

            <TabItem Header="{x:Static res:Strings.TabAppearance}" AutomationProperties.AutomationId="AppearanceTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <!-- Appearance -->
                        <TextBlock Text="{x:Static res:Strings.SettingsAppearance}" FontWeight="SemiBold" Margin="0,6,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SettingsPetSize}" VerticalAlignment="Center" />
                            <ItemsControl Grid.Column="1"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding SizeChoices}"
                                          AutomationProperties.AutomationId="PetSizeList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- The Fluent RadioButton style has a minimum width, which would make the three buttons equally wide. -->
                                        <RadioButton Margin="0,0,8,0"
                                                     MinWidth="0"
                                                     MinHeight="0"
                                                     VerticalAlignment="Bottom"
                                                     GroupName="PetSize"
                                                     IsChecked="{Binding IsCurrent, Mode=OneWay}"
                                                     Command="{Binding DataContext.ChooseSizeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                     CommandParameter="{Binding Size}"
                                                     ToolTip="{Binding Label}"
                                                     AutomationProperties.Name="{Binding Label}">
                                            <RadioButton.Template>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="Frame"
                                                            Padding="10,8"
                                                            BorderThickness="2"
                                                            CornerRadius="6"
                                                            Background="Transparent"
                                                            BorderBrush="{DynamicResource PetCardBorderBrush}"
                                                            Cursor="Hand">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource PetCardSelectedBorderBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource PetCardSelectedBorderBrush}" />
                                                            <Setter TargetName="Frame" Property="BorderThickness" Value="3" />
                                                            <Setter TargetName="Frame" Property="Padding" Value="9,7" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Frame" Property="Opacity" Value="0.7" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="Frame" Property="Opacity" Value="0.5" />
                                                            <Setter TargetName="Frame" Property="Cursor" Value="Arrow" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </RadioButton.Template>
                                            <StackPanel>
                                                <Image Source="{Binding Picture}"
                                                       Width="{Binding Width}"
                                                       Height="{Binding Height}"
                                                       HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding Label}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SettingsTheme}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Themes}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedTheme}"
                                      AutomationProperties.AutomationId="ThemeBox" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SettingsLanguage}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Languages}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedLanguage}"
                                      AutomationProperties.AutomationId="LanguageBox" />
                        </Grid>
                        <TextBlock Text="{x:Static res:Strings.LanguageRestartHint}" Opacity="0.65" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{x:Static res:Strings.TabBehavior}" AutomationProperties.AutomationId="BehaviorTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <!-- Time -->
                        <TextBlock Text="{x:Static res:Strings.SettingsTiming}" FontWeight="SemiBold" Margin="0,6,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{x:Static res:Strings.SettingsSedentary}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SedentaryText, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="4" pres:DigitsOnly.IsEnabled="True"
                                     AutomationProperties.AutomationId="SedentaryBox" />
                            <TextBlock Grid.Row="1" Text="{x:Static res:Strings.SettingsSleep}" VerticalAlignment="Center" Margin="0,6,0,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SleepText, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="4" pres:DigitsOnly.IsEnabled="True" Margin="0,6,0,0"
                                     AutomationProperties.AutomationId="SleepBox" />
                            <TextBlock Grid.Row="2" Text="{x:Static res:Strings.ClockOutTimeLabel}" VerticalAlignment="Center" Margin="0,6,0,0" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                                <ComboBox ItemsSource="{Binding HourChoices}"
                                          SelectedItem="{Binding ClockOutHour}"
                                          ItemStringFormat="00"
                                          Width="64"
                                          AutomationProperties.AutomationId="ClockOutHourBox" />
                                <TextBlock Text=":" VerticalAlignment="Center" Margin="6,0" />
                                <ComboBox ItemsSource="{Binding MinuteChoices}"
                                          SelectedItem="{Binding ClockOutMinute}"
                                          ItemStringFormat="00"
                                          Width="64"
                                          AutomationProperties.AutomationId="ClockOutMinuteBox" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding TimingError}"
                                   Style="{StaticResource ErrorTextStyle}"
                                   AutomationProperties.AutomationId="TimingError" />


                        <!-- Actions -->
                        <TextBlock Text="{x:Static res:Strings.SettingsActions}" FontWeight="SemiBold" Margin="0,18,0,6" />
                        <CheckBox IsChecked="{Binding ChatterEnabled}"
                                  AutomationProperties.Name="{x:Static res:Strings.SettingsChatter}"
                                  AutomationProperties.AutomationId="ChatterCheck">
                            <TextBlock Text="{x:Static res:Strings.SettingsChatter}" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox IsChecked="{Binding StrollWhileBusy}"
                                  Margin="0,4,0,0"
                                  AutomationProperties.Name="{x:Static res:Strings.SettingsStrollWhileBusy}"
                                  AutomationProperties.AutomationId="StrollWhileBusyCheck">
                            <TextBlock Text="{x:Static res:Strings.SettingsStrollWhileBusy}" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox IsChecked="{Binding ClimbEdges}"
                                  Margin="0,4,0,0"
                                  AutomationProperties.Name="{x:Static res:Strings.SettingsClimbEdges}"
                                  AutomationProperties.AutomationId="ClimbEdgesCheck">
                            <TextBlock Text="{x:Static res:Strings.SettingsClimbEdges}" TextWrapping="Wrap" />
                        </CheckBox>


                        <!-- Scenarios -->
                        <TextBlock Text="{x:Static res:Strings.SettingsScenarios}" FontWeight="SemiBold" Margin="0,18,0,6" />
                        <CheckBox Content="{x:Static res:Strings.ScenariosEnabled}"
                                  IsChecked="{Binding ScenariosEnabled}"
                                  AutomationProperties.AutomationId="ScenariosEnabledCheck" />
                        <ItemsControl ItemsSource="{Binding Scenarios}"
                                      IsEnabled="{Binding ScenariosEnabled}"
                                      Margin="20,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}"
                                              IsChecked="{Binding IsEnabled}"
                                              Margin="0,2,0,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>


                        <!-- Recognized programs -->
                        <TextBlock Text="{x:Static res:Strings.SettingsPrograms}" FontWeight="SemiBold" Margin="0,18,0,2" />
                        <TextBlock Text="{x:Static res:Strings.ProgramsHint}" Opacity="0.65" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding ProcessListNotice}"
                                   Style="{StaticResource NoticeTextStyle}"
                                   AutomationProperties.AutomationId="ProcessListNotice" />
                        <TextBlock Text="{x:Static res:Strings.DevProcessesLabel}" Margin="0,8,0,4" TextWrapping="Wrap" />
                        <TextBox Text="{Binding DevProcessesText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="70"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 AutomationProperties.AutomationId="DevProcessesBox" />
                        <TextBlock Text="{Binding DevProcessesError}"
                                   Style="{StaticResource ErrorTextStyle}"
                                   AutomationProperties.AutomationId="DevProcessesError" />
                        <TextBlock Text="{x:Static res:Strings.MeetingProcessesLabel}" Margin="0,8,0,4" TextWrapping="Wrap" />
                        <TextBox Text="{Binding MeetingProcessesText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="70"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 AutomationProperties.AutomationId="MeetingProcessesBox" />
                        <TextBlock Text="{Binding MeetingProcessesError}"
                                   Style="{StaticResource ErrorTextStyle}"
                                   AutomationProperties.AutomationId="MeetingProcessesError" />
                        <TextBlock Text="{x:Static res:Strings.ChatProcessesLabel}" Margin="0,8,0,4" TextWrapping="Wrap" />
                        <TextBox Text="{Binding ChatProcessesText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="70"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 AutomationProperties.AutomationId="ChatProcessesBox" />
                        <TextBlock Text="{Binding ChatProcessesError}"
                                   Style="{StaticResource ErrorTextStyle}"
                                   AutomationProperties.AutomationId="ChatProcessesError" />


                        <!-- Full screen -->
                        <TextBlock Text="{x:Static res:Strings.SettingsFullscreen}" FontWeight="SemiBold" Margin="0,18,0,6" />
                        <CheckBox Content="{x:Static res:Strings.AutoHide}"
                                  IsChecked="{Binding AutoHideWhenFullscreen}"
                                  AutomationProperties.AutomationId="AutoHideCheck" />
                        <CheckBox Content="{x:Static res:Strings.CoveredMonitor}"
                                  IsChecked="{Binding DetectCoveredMonitor}"
                                  Margin="0,4,0,0"
                                  AutomationProperties.AutomationId="CoveredMonitorCheck" />
                        <TextBlock Text="{x:Static res:Strings.BlacklistLabel}" Margin="0,8,0,4" TextWrapping="Wrap" />
                        <TextBox Text="{Binding BlacklistText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="70"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 AutomationProperties.AutomationId="BlacklistBox" />
                        <TextBlock Text="{Binding BlacklistError}"
                                   Style="{StaticResource ErrorTextStyle}"
                                   AutomationProperties.AutomationId="BlacklistError" />


                        <!-- Note -->
                        <TextBlock Text="{x:Static res:Strings.PetSupportNote}" Opacity="0.65" FontSize="11" TextWrapping="Wrap" Margin="0,18,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{x:Static res:Strings.TabSystem}" AutomationProperties.AutomationId="SystemTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <!-- System -->
                        <TextBlock Text="{x:Static res:Strings.SettingsSystem}" FontWeight="SemiBold" Margin="0,6,0,6" />
                        <CheckBox Content="{x:Static res:Strings.AutoStart}"
                                  IsChecked="{Binding AutoStart}"
                                  AutomationProperties.AutomationId="AutoStartCheck" />
                        <TextBlock Text="{Binding AutoStartError}"
                                   Style="{StaticResource ErrorTextStyle}"
                                   AutomationProperties.AutomationId="AutoStartError" />


                        <!-- Boss key -->
                        <TextBlock Text="{x:Static res:Strings.SettingsBossKey}" FontWeight="SemiBold" Margin="0,18,0,6" />
                        <TextBox Text="{Binding BossKeyText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 IsReadOnlyCaretVisible="False"
                                 PreviewKeyDown="OnBossKeyPreviewKeyDown"
                                 HorizontalAlignment="Left"
                                 Width="220"
                                 AutomationProperties.AutomationId="BossKeyBox" />
                        <TextBlock Text="{x:Static res:Strings.BossKeyHint}" Opacity="0.6" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding BossKeyError}"
                                   Style="{StaticResource ErrorTextStyle}"
                                   AutomationProperties.AutomationId="BossKeyError" />


                        <!-- Diagnostics -->
                        <TextBlock Text="{x:Static res:Strings.SettingsDiagnostics}" FontWeight="SemiBold" Margin="0,18,0,6" />
                        <Button Content="{x:Static res:Strings.OpenLogs}"
                                Command="{Binding OpenLogsCommand}"
                                HorizontalAlignment="Left"
                                Padding="12,4"
                                AutomationProperties.AutomationId="OpenLogsButton" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Saves or throws away the changes of the settings tabs; hidden on the pets tab, whose choices apply at once. -->
        <Grid x:Name="SettingsBar" Grid.Row="2" Margin="0,10,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{x:Static res:Strings.SettingsUnsaved}"
                       VerticalAlignment="Center"
                       Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibility}}"
                       AutomationProperties.AutomationId="UnsavedNote" />
            <Button Grid.Column="1"
                    Content="{x:Static res:Strings.SettingsSave}"
                    Command="{Binding SaveCommand}"
                    Padding="18,4"
                    Margin="0,0,8,0"
                    AutomationProperties.AutomationId="SaveSettingsButton" />
            <Button Grid.Column="2"
                    Content="{x:Static res:Strings.SettingsRevert}"
                    Command="{Binding RevertCommand}"
                    IsEnabled="{Binding HasUnsavedChanges}"
                    Padding="18,4"
                    AutomationProperties.AutomationId="RevertSettingsButton" />
        </Grid>
    </Grid>
</Window>
