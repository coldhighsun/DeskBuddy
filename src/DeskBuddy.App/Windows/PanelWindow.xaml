<Window x:Class="DeskBuddy.App.Windows.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:DeskBuddy.App.Resources"
        Title="{x:Static res:Strings.AppName}"
        Width="460"
        Height="560"
        MinWidth="380"
        MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- A TextBlock that is collapsed while its text is empty, for optional error messages. -->
        <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFD13438" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <TabControl x:Name="Tabs" Margin="12">
        <!-- Pomodoro -->
        <TabItem Header="{x:Static res:Strings.TabPomodoro}">
            <StackPanel DataContext="{Binding Pomodoro}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding RemainingText}"
                           FontSize="64"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           AutomationProperties.AutomationId="PomodoroRemaining" />
                <TextBlock Text="{Binding StatusText}"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           AutomationProperties.AutomationId="PomodoroStatus" />
                <TextBlock Text="{Binding CompletedText}"
                           Opacity="0.7"
                           Margin="0,6,0,0"
                           HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <Button Content="{Binding PrimaryLabel}"
                            Command="{Binding PrimaryCommand}"
                            MinWidth="120"
                            Padding="12,6"
                            AutomationProperties.AutomationId="PomodoroPrimary" />
                    <Button Content="{Binding SkipLabel}"
                            Command="{Binding SkipCommand}"
                            Visibility="{Binding HasActivePhase, Converter={StaticResource BoolToVisibility}}"
                            Margin="8,0,0,0"
                            Padding="12,6"
                            AutomationProperties.AutomationId="PomodoroSkip" />
                    <Button Content="{x:Static res:Strings.PomodoroStop}"
                            Command="{Binding StopCommand}"
                            Visibility="{Binding HasActivePhase, Converter={StaticResource BoolToVisibility}}"
                            Margin="8,0,0,0"
                            Padding="12,6"
                            AutomationProperties.AutomationId="PomodoroStop" />
                </StackPanel>
            </StackPanel>
        </TabItem>

        <!-- To-do -->
        <TabItem Header="{x:Static res:Strings.TabTodo}">
            <Grid DataContext="{Binding Todo}" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{x:Static res:Strings.TodoNewLabel}" Opacity="0.7" />

                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             MaxLength="200"
                             Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsEditable}"
                             AutomationProperties.AutomationId="NewTodoBox">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding AddCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1"
                            Content="{x:Static res:Strings.TodoAdd}"
                            Command="{Binding AddCommand}"
                            Margin="8,0,0,0"
                            Padding="14,5"
                            AutomationProperties.AutomationId="AddTodoButton" />
                </Grid>

                <TextBlock Grid.Row="2"
                           Text="{Binding ErrorMessage}"
                           Style="{StaticResource ErrorTextStyle}"
                           AutomationProperties.AutomationId="TodoError" />

                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <ListBox ItemsSource="{Binding Rows}"
                             HorizontalContentAlignment="Stretch"
                             AutomationProperties.AutomationId="TodoList">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True" Margin="0,2">
                                    <Button DockPanel.Dock="Right"
                                            Content="✕"
                                            ToolTip="{x:Static res:Strings.TodoDelete}"
                                            AutomationProperties.Name="{x:Static res:Strings.TodoDelete}"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Padding="8,2"
                                            Margin="8,0,0,0" />
                                    <CheckBox IsChecked="{Binding IsDone, Mode=OneWay}"
                                              Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                              CommandParameter="{Binding}"
                                              AutomationProperties.Name="{Binding Title}">
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                            <Setter Property="Opacity" Value="0.55" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </CheckBox>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{x:Static res:Strings.TodoEmpty}"
                               Opacity="0.6"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <Button Grid.Row="4"
                        Content="{x:Static res:Strings.TodoClearCompleted}"
                        Command="{Binding ClearCompletedCommand}"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0"
                        Padding="12,5"
                        AutomationProperties.AutomationId="ClearCompletedButton" />
            </Grid>
        </TabItem>

        <!-- Note -->
        <TabItem Header="{x:Static res:Strings.TabNote}">
            <Grid DataContext="{Binding Note}" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{x:Static res:Strings.NoteHint}" Opacity="0.7" />
                <TextBox Grid.Row="1"
                         Margin="0,6,0,0"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsEditable}"
                         AutomationProperties.AutomationId="NoteBox" />
                <TextBlock Grid.Row="2"
                           Text="{Binding ErrorMessage}"
                           Style="{StaticResource ErrorTextStyle}"
                           AutomationProperties.AutomationId="NoteError" />
            </Grid>
        </TabItem>

        <!-- Settings -->
        <TabItem Header="{x:Static res:Strings.TabSettings}" AutomationProperties.AutomationId="SettingsTab">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel DataContext="{Binding Settings}" Margin="12" IsEnabled="{Binding IsEditable}">
                    <TextBlock Text="{Binding LoadFailureMessage}"
                               Style="{StaticResource ErrorTextStyle}"
                               AutomationProperties.AutomationId="SettingsLoadError" />
                    <TextBlock Text="{Binding SaveError}"
                               Style="{StaticResource ErrorTextStyle}"
                               AutomationProperties.AutomationId="SettingsSaveError" />

                    <!-- Appearance -->
                    <TextBlock Text="{x:Static res:Strings.SettingsAppearance}" FontWeight="SemiBold" Margin="0,6,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SettingsSkin}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Skins}"
                                  SelectedItem="{Binding SelectedSkin}"
                                  AutomationProperties.AutomationId="SkinBox" />
                    </Grid>
                    <TextBlock Text="{Binding SkinError}"
                               Style="{StaticResource ErrorTextStyle}"
                               AutomationProperties.AutomationId="SkinError" />
                    <TextBlock Text="{x:Static res:Strings.SettingsMode}" Margin="0,10,0,4" />
                    <RadioButton GroupName="Mode"
                                 Content="{x:Static res:Strings.ModeDocked}"
                                 IsChecked="{Binding IsDocked}"
                                 AutomationProperties.AutomationId="ModeDocked" />
                    <RadioButton GroupName="Mode"
                                 Content="{x:Static res:Strings.ModeRoam}"
                                 IsChecked="{Binding IsRoam}"
                                 Margin="0,4,0,0"
                                 AutomationProperties.AutomationId="ModeRoam" />

                    <!-- Timing -->
                    <TextBlock Text="{x:Static res:Strings.SettingsTiming}" FontWeight="SemiBold" Margin="0,18,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{x:Static res:Strings.SettingsPomodoroWork}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PomodoroWorkText}" KeyDown="OnSettingsTextBoxKeyDown"
                                 AutomationProperties.AutomationId="PomodoroWorkBox" />
                        <TextBlock Grid.Row="1" Text="{x:Static res:Strings.SettingsPomodoroShortBreak}" VerticalAlignment="Center" Margin="0,6,0,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ShortBreakText}" KeyDown="OnSettingsTextBoxKeyDown" Margin="0,6,0,0"
                                 AutomationProperties.AutomationId="ShortBreakBox" />
                        <TextBlock Grid.Row="2" Text="{x:Static res:Strings.SettingsPomodoroLongBreak}" VerticalAlignment="Center" Margin="0,6,0,0" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LongBreakText}" KeyDown="OnSettingsTextBoxKeyDown" Margin="0,6,0,0"
                                 AutomationProperties.AutomationId="LongBreakBox" />
                        <TextBlock Grid.Row="3" Text="{x:Static res:Strings.SettingsSedentary}" VerticalAlignment="Center" Margin="0,6,0,0" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SedentaryText}" KeyDown="OnSettingsTextBoxKeyDown" Margin="0,6,0,0"
                                 AutomationProperties.AutomationId="SedentaryBox" />
                        <TextBlock Grid.Row="4" Text="{x:Static res:Strings.SettingsSleep}" VerticalAlignment="Center" Margin="0,6,0,0" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SleepText}" KeyDown="OnSettingsTextBoxKeyDown" Margin="0,6,0,0"
                                 AutomationProperties.AutomationId="SleepBox" />
                    </Grid>
                    <TextBlock Text="{Binding TimingError}"
                               Style="{StaticResource ErrorTextStyle}"
                               AutomationProperties.AutomationId="TimingError" />

                    <!-- Boss key -->
                    <TextBlock Text="{x:Static res:Strings.SettingsBossKey}" FontWeight="SemiBold" Margin="0,18,0,6" />
                    <TextBox Text="{Binding BossKeyText, Mode=OneWay}"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="False"
                             PreviewKeyDown="OnBossKeyPreviewKeyDown"
                             HorizontalAlignment="Left"
                             Width="220"
                             AutomationProperties.AutomationId="BossKeyBox" />
                    <TextBlock Text="{x:Static res:Strings.BossKeyHint}" Opacity="0.6" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding BossKeyError}"
                               Style="{StaticResource ErrorTextStyle}"
                               AutomationProperties.AutomationId="BossKeyError" />

                    <!-- Full screen -->
                    <TextBlock Text="{x:Static res:Strings.SettingsFullscreen}" FontWeight="SemiBold" Margin="0,18,0,6" />
                    <CheckBox Content="{x:Static res:Strings.AutoHide}"
                              IsChecked="{Binding AutoHideWhenFullscreen}"
                              AutomationProperties.AutomationId="AutoHideCheck" />
                    <CheckBox Content="{x:Static res:Strings.CoveredMonitor}"
                              IsChecked="{Binding DetectCoveredMonitor}"
                              Margin="0,4,0,0"
                              AutomationProperties.AutomationId="CoveredMonitorCheck" />
                    <TextBlock Text="{x:Static res:Strings.BlacklistLabel}" Margin="0,10,0,4" TextWrapping="Wrap" />
                    <TextBox Text="{Binding BlacklistText}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="70"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             AutomationProperties.AutomationId="BlacklistBox" />

                    <!-- System -->
                    <TextBlock Text="{x:Static res:Strings.SettingsSystem}" FontWeight="SemiBold" Margin="0,18,0,6" />
                    <CheckBox Content="{x:Static res:Strings.AutoStart}"
                              IsChecked="{Binding AutoStart}"
                              AutomationProperties.AutomationId="AutoStartCheck" />
                    <TextBlock Text="{Binding AutoStartError}"
                               Style="{StaticResource ErrorTextStyle}"
                               AutomationProperties.AutomationId="AutoStartError" />

                    <!-- Diagnostics -->
                    <TextBlock Text="{x:Static res:Strings.SettingsDiagnostics}" FontWeight="SemiBold" Margin="0,18,0,6" />
                    <Button Content="{x:Static res:Strings.OpenLogs}"
                            Command="{Binding OpenLogsCommand}"
                            HorizontalAlignment="Left"
                            Padding="12,4"
                            AutomationProperties.AutomationId="OpenLogsButton" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
