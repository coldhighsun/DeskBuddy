<Window x:Class="DeskBuddy.App.Windows.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:DeskBuddy.App.Resources"
        xmlns:pres="clr-namespace:DeskBuddy.App.Presentation"
        xmlns:win="clr-namespace:DeskBuddy.App.Windows"
        Style="{StaticResource DialogWindowStyle}"
        Title="{res:Loc AppName}"
        Icon="pack://application:,,,/DeskBuddy;component/Assets/DeskBuddy.ico"
        Width="560"
        Height="670"
        ResizeMode="CanMinimize"
        ShowInTaskbar="True"
        Padding="0"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

            <!-- A TextBlock that is collapsed while its text is empty, for optional messages. -->
            <Style x:Key="OptionalTextStyle" TargetType="TextBlock" >
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,4,0,0" />
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- The icon in front of a tab title: Segoe Fluent Icons on Windows 11, Segoe MDL2 Assets before it. -->
            <Style x:Key="TabIconStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- An optional error message. -->
            <Style x:Key="ErrorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource OptionalTextStyle}">
                <Setter Property="Foreground" Value="{DynamicResource AppDanger}" />
            </Style>

            <!-- An optional note that is no error. -->
            <Style x:Key="NoticeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource OptionalTextStyle}">
                <Setter Property="FontSize" Value="{StaticResource SettingsCaptionSize}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid DataContext="{Binding Settings}" IsEnabled="{Binding IsEditable}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,0,16,0">
            <TextBlock Text="{Binding LoadFailureMessage}"
                       Style="{StaticResource ErrorTextStyle}"
                       AutomationProperties.AutomationId="SettingsLoadError" />
            <TextBlock Text="{Binding SaveError}"
                       Style="{StaticResource ErrorTextStyle}"
                       AutomationProperties.AutomationId="SettingsSaveError" />
        </StackPanel>

        <TabControl x:Name="Tabs" Grid.Row="1" Margin="0,4,0,0" SelectedIndex="0" Style="{StaticResource AppTabControl}">
            <TabItem AutomationProperties.Name="{res:Loc TabPets}"
                     AutomationProperties.AutomationId="PetsTab"
                     DataContext="{Binding DataContext.Pets, RelativeSource={RelativeSource AncestorType=Window}}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TabIconStyle}" Text="&#xE006;" />
                        <TextBlock Text="{res:Loc TabPets}" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="16,16,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                        <TextBlock Text="{res:Loc PetsLoading}"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibility}}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{res:Loc PetsEmpty}"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   TextWrapping="Wrap" />
                        <!-- One pet to a row. A row is short (a small picture, the name and the "current" mark) until it is
                             picked, and then opens to show the moving preview, what the pet can do and the button to use it, so
                             that many pets fit in a short list and every row has the whole width, whatever the scaling is. -->
                        <ItemsControl x:Name="PetCardList" ItemsSource="{Binding Cards}" AutomationProperties.AutomationId="PetCards">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border ToolTip="{Binding Details}"
                                            AutomationProperties.Name="{Binding DisplayName}"
                                            AutomationProperties.HelpText="{Binding Details}"
                                            Margin="0,0,0,6"
                                            MouseLeftButtonUp="OnPetCardMouseLeftButtonUp"
                                            AutomationProperties.AutomationId="{Binding FolderName, StringFormat=PetCard_{0}}">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource SettingsCardBorderStyle}">
                                                <Setter Property="Padding" Value="8" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AppForegroundMuted}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AppPrimary}" />
                                                        <Setter Property="Background" Value="{DynamicResource AppPrimarySoft}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                        <Setter Property="Padding" Value="7" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                        <Setter Property="Cursor" Value="Hand" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- The picture, small until the row is picked, and the name of the state it shows. -->
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Image HorizontalAlignment="Center"
                                                       Source="{Binding CurrentFrame}"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Width" Value="40" />
                                                            <Setter Property="Height" Value="40" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Width" Value="80" />
                                                                    <Setter Property="Height" Value="80" />
                                                                </DataTrigger>
                                                                <!-- A pet that is switched off is shown dimmed, but still readable. -->
                                                                <DataTrigger Binding="{Binding IsShown}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.45" />
                                                                </DataTrigger>
                                                                <!-- A pet that could not be loaded has no picture: a broken-pet mark stands in for it. -->
                                                                <DataTrigger Binding="{Binding IsBroken}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <Border Width="40"
                                                        Height="40"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource AppDangerSoft}"
                                                        Visibility="{Binding IsBroken, Converter={StaticResource BooleanToVisibility}}"
                                                        AutomationProperties.AutomationId="{Binding FolderName, StringFormat=PetBroken_{0}}">
                                                    <TextBlock Style="{StaticResource IconText}"
                                                               Text="&#xE7BA;"
                                                               FontSize="20"
                                                               Foreground="{DynamicResource AppDanger}" />
                                                </Border>
                                                <TextBlock Text="{Binding StateCaption}"
                                                           HorizontalAlignment="Center"
                                                           FontSize="{StaticResource SettingsCaptionSize}"
                                                           MinHeight="16"
                                                           Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- The name, why a pet that could not be loaded cannot be used, and, once the row is picked,
                                                 what the pet can do. -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <!-- The name, with a small label for where the pet comes from. -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold"
                                                               MaxWidth="220"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsShown}" Value="False">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AppForegroundMuted}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Border Grid.Column="1"
                                                            Style="{StaticResource SettingsChipBorderStyle}"
                                                            Margin="8,0,0,0"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            ToolTip="{Binding OriginToolTip}"
                                                            AutomationProperties.AutomationId="{Binding FolderName, StringFormat=PetOrigin_{0}}">
                                                        <TextBlock Text="{Binding OriginText}"
                                                                   FontSize="{StaticResource SettingsCaptionSize}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AppForegroundMuted}" />
                                                                    <Style.Triggers>
                                                                        <!-- The user's own pets stand out from the ones that come with the application. -->
                                                                        <DataTrigger Binding="{Binding CanDelete}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource AppPrimary}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                                <!-- The size of the pictures and the number of states, on every row: a pet that could not be loaded
                                                     has none to tell. -->
                                                <TextBlock Text="{Binding InfoText}"
                                                           FontSize="{StaticResource SettingsCaptionSize}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding LoadError}"
                                                           ToolTip="{Binding LoadError}"
                                                           Style="{StaticResource ErrorTextStyle}"
                                                           MaxHeight="48"
                                                           FontSize="{StaticResource SettingsCaptionSize}" />
                                                <StackPanel>
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsSelected}" Value="True" />
                                                                        <Condition Binding="{Binding IsAvailable}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <!-- What the pet can do: one chip per supported ability. -->
                                                    <ItemsControl ItemsSource="{Binding Tags}" Margin="0,4,0,0" Focusable="False" IsTabStop="False">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border>
                                                                    <Border.Style>
                                                                        <Style TargetType="Border" BasedOn="{StaticResource SettingsChipBorderStyle}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSupported}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding Text}"
                                                                               Foreground="{DynamicResource AppForeground}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               FontSize="{StaticResource SettingsCaptionSize}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- On the right of every row, whether it is picked or not: the "current" mark or the "use" button,
                                                 the switch that offers the pet when the user changes to another one, and the delete button. -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <!-- One slot holds either the "current" mark or the "use" button. The visibility style sits on a
                                                 wrapper: a style on the Button itself would replace the themed button style. -->
                                            <Grid VerticalAlignment="Center">
                                                <Border Background="{DynamicResource AppPrimary}"
                                                        CornerRadius="{StaticResource SettingsPillRadius}"
                                                        Padding="12,2"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsCurrent, Converter={StaticResource BooleanToVisibility}}">
                                                    <TextBlock Text="{res:Loc PetsCurrent}"
                                                               Foreground="{DynamicResource AppPrimaryForeground}"
                                                               FontSize="{StaticResource SettingsCaptionSize}"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                                <Grid>
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsSelected}" Value="True" />
                                                                        <Condition Binding="{Binding IsCurrent}" Value="False" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Button Content="{res:Loc PetsUse}"
                                                            Padding="16,3"
                                                            MinHeight="28"
                                                            MinWidth="72"
                                                            Style="{StaticResource RaisedButton}"
                                                            Command="{Binding DataContext.UseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            AutomationProperties.AutomationId="{Binding FolderName, StringFormat=PetUse_{0}}" />
                                                </Grid>
                                            </Grid>

                                            <!-- Offered when changing pet. IsChecked is two-way, so the switch has the value the user wants
                                                 when the command runs. A pet that could not be loaded cannot be offered, so it has none. -->
                                            <ToggleButton Style="{StaticResource SwitchToggle}"
                                                          Margin="12,0,0,0"
                                                          IsChecked="{Binding IsShown, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanChangeShown}"
                                                          ToolTip="{Binding ShownToolTip}"
                                                          ToolTipService.ShowOnDisabled="True"
                                                          Command="{Binding DataContext.ToggleShownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}"
                                                          AutomationProperties.AutomationId="{Binding FolderName, StringFormat=PetShown_{0}}">
                                                <ToggleButton.Visibility>
                                                    <Binding Path="IsAvailable" Converter="{StaticResource BooleanToVisibility}" />
                                                </ToggleButton.Visibility>
                                            </ToggleButton>

                                            <Button Style="{StaticResource IconButton}"
                                                    Width="32"
                                                    Height="32"
                                                    Margin="6,0,0,0"
                                                    IsEnabled="{Binding CanDeleteNow}"
                                                    ToolTip="{Binding DeleteToolTip}"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.AutomationId="{Binding FolderName, StringFormat=PetDelete_{0}}">
                                                <TextBlock Style="{StaticResource IconText}"
                                                           Text="&#xE74D;"
                                                           FontSize="14"
                                                           Foreground="{DynamicResource AppForegroundMuted}" />
                                            </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Grid.Row="1"
                               Text="{Binding PetError}"
                               Style="{StaticResource ErrorTextStyle}"
                               AutomationProperties.AutomationId="PetError" />
                    <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Content="{res:Loc PetsOpenFolder}"
                                Command="{Binding OpenPetsFolderCommand}"
                                Padding="14,3" MinHeight="28"
                                Visibility="{Binding CanOpenPetsFolder, Converter={StaticResource BooleanToVisibility}}"
                                AutomationProperties.AutomationId="OpenPetsFolderButton" />
                        <TextBlock Text="{res:Loc PetsOpenFolderHint}"
                                   Style="{StaticResource SettingsHintStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Visibility="{Binding CanOpenPetsFolder, Converter={StaticResource BooleanToVisibility}}" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem AutomationProperties.Name="{res:Loc TabAppearance}" AutomationProperties.AutomationId="AppearanceTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TabIconStyle}" Text="&#xE790;" />
                        <TextBlock Text="{res:Loc TabAppearance}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <!-- The label columns of the rows share one width, so the controls line up. -->
                    <StackPanel Margin="16,16,16,4" Grid.IsSharedSizeScope="True">
                      <Border Style="{StaticResource SettingsGroupCardStyle}">
                       <StackPanel>
                        <!-- Appearance -->
                        <TextBlock Text="{res:Loc SettingsAppearance}"
                                   Style="{StaticResource SettingsSectionHeaderStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{res:Loc SettingsLanguage}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Languages}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedLanguage}"
                                      AutomationProperties.AutomationId="LanguageBox" />
                        </Grid>
                        <Grid Margin="{StaticResource SettingsRowGap}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{res:Loc SettingsTheme}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Themes}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedTheme}"
                                      AutomationProperties.AutomationId="ThemeBox" />
                        </Grid>
                        <Grid Margin="{StaticResource SettingsRowGap}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{res:Loc SettingsPetSize}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <ItemsControl Grid.Column="1"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding SizeChoices}"
                                          AutomationProperties.AutomationId="PetSizeList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- The Fluent RadioButton style has a minimum width, which would make the three buttons equally wide. -->
                                        <RadioButton Margin="0,0,6,0"
                                                     MinWidth="0"
                                                     MinHeight="0"
                                                     VerticalAlignment="Bottom"
                                                     GroupName="PetSize"
                                                     IsChecked="{Binding IsCurrent, Mode=OneWay}"
                                                     Command="{Binding DataContext.ChooseSizeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                     CommandParameter="{Binding Size}"
                                                     ToolTip="{Binding Label}"
                                                     AutomationProperties.Name="{Binding Label}">
                                            <RadioButton.Template>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="Frame"
                                                            Style="{StaticResource SettingsCardBorderStyle}"
                                                            Padding="9,7"
                                                            Cursor="Hand">
                                                        <StackPanel>
                                                            <Image x:Name="Picture"
                                                                   Source="{Binding Picture}"
                                                                   Width="{Binding Width}"
                                                                   Height="{Binding Height}"
                                                                   HorizontalAlignment="Center" />
                                                            <TextBlock Text="{Binding Label}"
                                                                       HorizontalAlignment="Center"
                                                                       Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AppPrimary}" />
                                                        </Trigger>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AppPrimary}" />
                                                            <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                                                            <Setter TargetName="Frame" Property="Padding" Value="8,6" />
                                                        </Trigger>
                                                        <!-- The label is greyed through its color, not its opacity, to keep ClearType. -->
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Picture" Property="Opacity" Value="0.7" />
                                                            <Setter TargetName="Frame" Property="TextElement.Foreground" Value="{DynamicResource AppForegroundMuted}" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="Picture" Property="Opacity" Value="0.5" />
                                                            <Setter TargetName="Frame" Property="TextElement.Foreground" Value="{DynamicResource AppForegroundMuted}" />
                                                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AppDivider}" />
                                                            <Setter TargetName="Frame" Property="Cursor" Value="Arrow" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </RadioButton.Template>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <Grid Margin="{StaticResource SettingsRowGap}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{res:Loc SettingsSwitchEffect}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding SwitchEffects}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedSwitchEffect}"
                                      AutomationProperties.AutomationId="SwitchEffectBox" />
                        </Grid>
                        <CheckBox IsChecked="{Binding AutoSwitchPet}"
                                  Margin="{StaticResource SettingsRowGap}" MinHeight="24"
                                  AutomationProperties.Name="{res:Loc SettingsAutoSwitchPet}"
                                  AutomationProperties.AutomationId="AutoSwitchPetCheck">
                            <TextBlock Text="{res:Loc SettingsAutoSwitchPet}" TextWrapping="Wrap" />
                        </CheckBox>
                        <Grid Margin="{StaticResource SettingsRowGap}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{res:Loc SettingsAutoSwitchPetInterval}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox Grid.Column="1"
                                      IsEnabled="{Binding AutoSwitchPet}"
                                      ItemsSource="{Binding AutoSwitchIntervals}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedAutoSwitchInterval}"
                                      AutomationProperties.AutomationId="AutoSwitchIntervalBox" />
                        </Grid>
                       </StackPanel>
                      </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem AutomationProperties.Name="{res:Loc TabBehavior}" AutomationProperties.AutomationId="BehaviorTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TabIconStyle}" Text="&#xE768;" />
                        <TextBlock Text="{res:Loc TabBehavior}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,16,16,4">
                      <Border Style="{StaticResource SettingsGroupCardStyle}">
                       <StackPanel>
                        <!-- Time -->
                        <TextBlock Text="{res:Loc SettingsTiming}"
                                   Style="{StaticResource SettingsSectionHeaderStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{res:Loc SettingsSedentary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SedentaryText, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="4" pres:DigitsOnly.IsEnabled="True"
                                     AutomationProperties.AutomationId="SedentaryBox" />
                            <TextBlock Grid.Row="1" Text="{res:Loc SettingsSleep}" VerticalAlignment="Center" Margin="0,6,12,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SleepText, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="4" pres:DigitsOnly.IsEnabled="True" Margin="{StaticResource SettingsRowGap}"
                                     AutomationProperties.AutomationId="SleepBox" />
                            <TextBlock Grid.Row="2" Text="{res:Loc ClockOutTimeLabel}" VerticalAlignment="Center" Margin="0,6,12,0" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="{StaticResource SettingsRowGap}">
                                <ComboBox ItemsSource="{Binding HourChoices}"
                                          SelectedItem="{Binding ClockOutHour}"
                                          ItemStringFormat="00"
                                          Width="64"
                                          AutomationProperties.AutomationId="ClockOutHourBox" />
                                <TextBlock Text=":" VerticalAlignment="Center" Margin="6,0" />
                                <ComboBox ItemsSource="{Binding MinuteChoices}"
                                          SelectedItem="{Binding ClockOutMinute}"
                                          ItemStringFormat="00"
                                          Width="64"
                                          AutomationProperties.AutomationId="ClockOutMinuteBox" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding TimingError}"
                                   Style="{StaticResource ErrorTextStyle}"
                                   AutomationProperties.AutomationId="TimingError" />


                       </StackPanel>
                      </Border>
                      <Border Style="{StaticResource SettingsGroupCardStyle}">
                       <StackPanel>
                        <!-- Actions -->
                        <TextBlock Text="{res:Loc SettingsActions}" Style="{StaticResource SettingsSectionHeaderStyle}" />
                        <CheckBox IsChecked="{Binding ChatterEnabled}"
                                  Margin="0,2,0,0" MinHeight="24"
                                  AutomationProperties.Name="{res:Loc SettingsChatter}"
                                  AutomationProperties.AutomationId="ChatterCheck">
                            <TextBlock Text="{res:Loc SettingsChatter}" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox IsChecked="{Binding StrollWhileBusy}"
                                  Margin="0,2,0,0" MinHeight="24"
                                  AutomationProperties.Name="{res:Loc SettingsStrollWhileBusy}"
                                  AutomationProperties.AutomationId="StrollWhileBusyCheck">
                            <TextBlock Text="{res:Loc SettingsStrollWhileBusy}" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox IsChecked="{Binding InteractionReactions}"
                                  Margin="0,2,0,0" MinHeight="24"
                                  AutomationProperties.Name="{res:Loc SettingsInteractionReactions}"
                                  AutomationProperties.AutomationId="InteractionReactionsCheck">
                            <TextBlock Text="{res:Loc SettingsInteractionReactions}" TextWrapping="Wrap" />
                        </CheckBox>


                       </StackPanel>
                      </Border>
                      <Border Style="{StaticResource SettingsGroupCardStyle}">
                       <StackPanel>
                        <!-- Scenarios -->
                        <TextBlock Text="{res:Loc SettingsScenarios}" Style="{StaticResource SettingsSectionHeaderStyle}" />
                        <CheckBox Content="{res:Loc ScenariosEnabled}"
                                  IsChecked="{Binding ScenariosEnabled}"
                                  Margin="0,2,0,0" MinHeight="24"
                                  AutomationProperties.AutomationId="ScenariosEnabledCheck" />
                        <TextBlock Text="{res:Loc ScenariosHoverHint}" Style="{StaticResource SettingsHintStyle}" Margin="0,2,0,2" />
                        <ItemsControl ItemsSource="{Binding Scenarios}"
                                      IsEnabled="{Binding ScenariosEnabled}"
                                      Margin="20,0,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsEnabled}"
                                              Margin="0,2,0,0"
                                              MinHeight="24"
                                              ToolTip="{Binding Description}"
                                              AutomationProperties.Name="{Binding Label}"
                                              AutomationProperties.HelpText="{Binding Description}">
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>


                       </StackPanel>
                      </Border>
                      <Border Style="{StaticResource SettingsGroupCardStyle}">
                       <StackPanel>
                        <!-- Recognized programs -->
                        <TextBlock Text="{res:Loc SettingsPrograms}" Style="{StaticResource SettingsSectionHeaderStyle}" />
                        <TextBlock Text="{res:Loc ProgramsHint}" Style="{StaticResource SettingsHintStyle}" Margin="0" />
                        <TextBlock Text="{Binding ProcessListNotice}"
                                   Style="{StaticResource NoticeTextStyle}"
                                   AutomationProperties.AutomationId="ProcessListNotice" />
                        <TextBlock Text="{res:Loc DevProcessesLabel}" TextWrapping="Wrap" Margin="0,6,0,2" />
                        <TextBox Text="{Binding DevProcessesText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 AutomationProperties.AutomationId="DevProcessesBox" />
                        <TextBlock Text="{Binding DevProcessesError}"
                                   Style="{StaticResource ErrorTextStyle}"
                                   AutomationProperties.AutomationId="DevProcessesError" />
                        <TextBlock Text="{res:Loc MeetingProcessesLabel}" TextWrapping="Wrap" Margin="0,6,0,2" />
                        <TextBox Text="{Binding MeetingProcessesText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 AutomationProperties.AutomationId="MeetingProcessesBox" />
                        <TextBlock Text="{Binding MeetingProcessesError}"
                                   Style="{StaticResource ErrorTextStyle}"
                                   AutomationProperties.AutomationId="MeetingProcessesError" />
                        <TextBlock Text="{res:Loc ChatProcessesLabel}" TextWrapping="Wrap" Margin="0,6,0,2" />
                        <TextBox Text="{Binding ChatProcessesText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 AutomationProperties.AutomationId="ChatProcessesBox" />
                        <TextBlock Text="{Binding ChatProcessesError}"
                                   Style="{StaticResource ErrorTextStyle}"
                                   AutomationProperties.AutomationId="ChatProcessesError" />


                       </StackPanel>
                      </Border>
                      <Border Style="{StaticResource SettingsGroupCardStyle}">
                       <StackPanel>
                        <!-- Full screen -->
                        <TextBlock Text="{res:Loc SettingsFullscreen}" Style="{StaticResource SettingsSectionHeaderStyle}" />
                        <CheckBox Content="{res:Loc AutoHide}"
                                  IsChecked="{Binding AutoHideWhenFullscreen}"
                                  Margin="0,2,0,0" MinHeight="24"
                                  AutomationProperties.AutomationId="AutoHideCheck" />
                        <CheckBox Content="{res:Loc CoveredMonitor}"
                                  IsChecked="{Binding DetectCoveredMonitor}"
                                  Margin="0,2,0,0" MinHeight="24"
                                  AutomationProperties.AutomationId="CoveredMonitorCheck" />
                        <TextBlock Text="{res:Loc BlacklistLabel}" TextWrapping="Wrap" Margin="0,6,0,2" />
                        <TextBox Text="{Binding BlacklistText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 AutomationProperties.AutomationId="BlacklistBox" />
                        <TextBlock Text="{Binding BlacklistError}"
                                   Style="{StaticResource ErrorTextStyle}"
                                   AutomationProperties.AutomationId="BlacklistError" />


                       </StackPanel>
                      </Border>
                        <!-- Note -->
                        <TextBlock Text="{res:Loc PetSupportNote}" Style="{StaticResource SettingsHintStyle}" Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem AutomationProperties.Name="{res:Loc TabSystem}" AutomationProperties.AutomationId="SystemTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TabIconStyle}" Text="&#xE713;" />
                        <TextBlock Text="{res:Loc TabSystem}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,16,16,4">
                      <Border Style="{StaticResource SettingsGroupCardStyle}">
                       <StackPanel>
                        <!-- System -->
                        <TextBlock Text="{res:Loc SettingsSystem}"
                                   Style="{StaticResource SettingsSectionHeaderStyle}" />
                        <CheckBox Content="{res:Loc AutoStart}"
                                  IsChecked="{Binding AutoStart}"
                                  Margin="0,2,0,0" MinHeight="24"
                                  AutomationProperties.AutomationId="AutoStartCheck" />
                        <TextBlock Text="{Binding AutoStartError}"
                                   Style="{StaticResource ErrorTextStyle}"
                                   AutomationProperties.AutomationId="AutoStartError" />
                        <CheckBox Content="{res:Loc SettingsAutoCheckUpdates}"
                                  IsChecked="{Binding AutoCheckUpdates}"
                                  Margin="0,2,0,0" MinHeight="24"
                                  AutomationProperties.AutomationId="AutoCheckUpdatesCheck" />


                       </StackPanel>
                      </Border>
                      <Border Style="{StaticResource SettingsGroupCardStyle}">
                       <StackPanel>
                        <!-- Boss key -->
                        <TextBlock Text="{res:Loc SettingsBossKey}" Style="{StaticResource SettingsSectionHeaderStyle}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                         <Grid Width="220">
                          <TextBox Text="{Binding BossKeyText, Mode=OneWay}"
                                   IsReadOnly="True"
                                   IsReadOnlyCaretVisible="False"
                                   PreviewKeyDown="OnBossKeyPreviewKeyDown"
                                   AutomationProperties.AutomationId="BossKeyBox" />
                          <TextBlock Text="{res:Loc BossKeyNone}"
                                     IsHitTestVisible="False"
                                     VerticalAlignment="Center"
                                     Margin="12,0,0,0"
                                     Foreground="{DynamicResource AppForegroundMuted}">
                           <TextBlock.Style>
                            <Style TargetType="TextBlock">
                             <Setter Property="Visibility" Value="Collapsed" />
                             <Style.Triggers>
                              <DataTrigger Binding="{Binding HasBossKey}" Value="False">
                               <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                             </Style.Triggers>
                            </Style>
                           </TextBlock.Style>
                          </TextBlock>
                         </Grid>
                         <Button Content="{res:Loc BossKeyClear}"
                                 Command="{Binding ClearBossKeyCommand}"
                                 IsEnabled="{Binding HasBossKey}"
                                 Margin="8,0,0,0"
                                 AutomationProperties.AutomationId="BossKeyClearButton" />
                        </StackPanel>
                        <TextBlock Text="{res:Loc BossKeyHint}" Style="{StaticResource SettingsHintStyle}" />
                        <TextBlock Text="{Binding BossKeyError}"
                                   Style="{StaticResource ErrorTextStyle}"
                                   AutomationProperties.AutomationId="BossKeyError" />


                       </StackPanel>
                      </Border>
                      <Border Style="{StaticResource SettingsGroupCardStyle}">
                       <StackPanel>
                        <!-- Diagnostics -->
                        <TextBlock Text="{res:Loc SettingsDiagnostics}" Style="{StaticResource SettingsSectionHeaderStyle}" />
                        <Button Content="{res:Loc OpenLogs}"
                                Command="{Binding OpenLogsCommand}"
                                HorizontalAlignment="Left"
                                Padding="14,3" MinHeight="28"
                                AutomationProperties.AutomationId="OpenLogsButton" />
                       </StackPanel>
                      </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem AutomationProperties.Name="{res:Loc TabAbout}" AutomationProperties.AutomationId="AboutTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TabIconStyle}" Text="&#xE946;" />
                        <TextBlock Text="{res:Loc TabAbout}" />
                    </StackPanel>
                </TabItem.Header>
                <win:AboutView x:Name="About" />
            </TabItem>
        </TabControl>

        <!-- Saves or throws away the changes of the settings tabs; hidden on the pets tab, whose choices apply at once. -->
        <Border x:Name="SettingsBar" Grid.Row="2" Visibility="Collapsed"
                Background="{DynamicResource AppBarBackground}"
                BorderBrush="{DynamicResource AppDivider}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{res:Loc SettingsUnsaved}"
                       VerticalAlignment="Center"
                       Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibility}}"
                       AutomationProperties.AutomationId="UnsavedNote" />
            <Button Grid.Column="1"
                    Content="{res:Loc SettingsRevert}"
                    Command="{Binding RevertCommand}"
                    IsEnabled="{Binding HasUnsavedChanges}"
                    Style="{StaticResource FlatButton}"
                    MinWidth="80"
                    Margin="0,0,8,0"
                    AutomationProperties.AutomationId="RevertSettingsButton" />
            <Button Grid.Column="2"
                    Content="{res:Loc SettingsSave}"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource RaisedButton}"
                    MinWidth="80"
                    AutomationProperties.AutomationId="SaveSettingsButton" />
        </Grid>
        </Border>
    </Grid>
</Window>
