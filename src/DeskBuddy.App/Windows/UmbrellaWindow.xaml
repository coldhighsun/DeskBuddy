<Window x:Class="DeskBuddy.App.Windows.UmbrellaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskBuddy umbrella"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        IsHitTestVisible="False"
        SnapsToDevicePixels="True">
    <!-- Same hardware-accelerated transparent window technique as PetWindow (see there). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="-1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <!-- The canopy window reaches from the dome down to where the pet holds on. The dome is drawn in a 140 x 64 box at
         the top (rim at the bottom of it); the shaft or the strings are drawn in code from it down to the pet's grips,
         behind the pet window, so its paws cover their ends. -->
    <Canvas x:Name="Root">
        <Path x:Name="Rigging" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0" />
        <Viewbox x:Name="DomeBox" Stretch="Fill">
            <Canvas x:Name="Prop"
                    Width="140"
                    Height="64"
                    RenderTransformOrigin="0.5,1">
                <Canvas.RenderTransform>
                    <ScaleTransform x:Name="PropScale" ScaleX="0.1" ScaleY="0.1" />
                </Canvas.RenderTransform>

                <!-- Umbrella: a red dome with a scalloped rim and ribs. -->
                <Canvas x:Name="UmbrellaShape" Visibility="Collapsed">
                    <Path Data="M 10,62 C 10,22 40,6 70,6 C 100,6 130,22 130,62 Q 118,52 106,62 Q 94,52 82,62 Q 70,52 58,62 Q 46,52 34,62 Q 22,52 10,62 Z"
                          Fill="#FFE4504A" Stroke="#FF8E2A26" StrokeThickness="2" StrokeLineJoin="Round" />
                    <Path Data="M 70,6 C 58,24 56,44 58,60 M 70,6 C 82,24 84,44 82,60"
                          Stroke="#FF8E2A26" StrokeThickness="1.6" />
                </Canvas>

                <!-- Parachute: a striped dome with a scalloped rim. -->
                <Canvas x:Name="ParachuteShape" Visibility="Collapsed">
                    <Path Data="M 8,50 C 8,14 36,4 70,4 C 104,4 132,14 132,50 Q 120,40 108,50 Q 96,40 84,50 Q 70,40 56,50 Q 44,40 32,50 Q 20,40 8,50 Z"
                          Fill="#FFF2F2F2" Stroke="#FF6A6A6A" StrokeThickness="2" StrokeLineJoin="Round" />
                    <Path Data="M 70,4 C 60,16 56,32 56,48 Q 63,42 70,48 Q 77,42 84,48 C 84,32 80,16 70,4 Z"
                          Fill="#FF4C8FE0" />
                    <Path Data="M 22,12 C 12,22 8,36 8,50 Q 14,45 20,46 C 20,34 20,22 22,12 Z M 118,12 C 128,22 132,36 132,50 Q 126,45 120,46 C 120,34 120,22 118,12 Z"
                          Fill="#FFF2B33D" />
                </Canvas>
            </Canvas>
        </Viewbox>
    </Canvas>
</Window>
