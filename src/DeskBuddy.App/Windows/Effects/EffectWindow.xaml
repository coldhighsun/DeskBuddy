<Window x:Class="DeskBuddy.App.Windows.EffectWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskBuddy effect"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        IsHitTestVisible="False"
        SnapsToDevicePixels="False">
    <!-- Same hardware-accelerated transparent window technique as PetWindow (see there). The animation of a pet switch is
         drawn in code onto Root, over the pet window. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="-1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Canvas x:Name="Root" ClipToBounds="True" />
</Window>
