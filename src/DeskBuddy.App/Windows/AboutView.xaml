<UserControl x:Class="DeskBuddy.App.Windows.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:DeskBuddy.App.Resources"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,16,16,8">
            <!-- The hero: the logo on a tinted tile, name, version and license, then the description. -->
            <Border Style="{DynamicResource SettingsGroupCardStyle}" Padding="20,20,20,18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource AppPrimarySoft}"
                                CornerRadius="16"
                                Padding="10"
                                VerticalAlignment="Center">
                            <!-- The picture is set in code: an Image given an .ico shows its first (16 pixel) frame, scaled up and blurry. -->
                            <Image x:Name="LogoImage"
                                   Width="64"
                                   Height="64"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static res:Strings.AppName}"
                                       FontSize="{DynamicResource FontSizeDisplay}"
                                       FontWeight="SemiBold" />
                            <Border Style="{DynamicResource SettingsChipBorderStyle}"
                                    HorizontalAlignment="Left"
                                    Margin="0,6,0,0"
                                    Padding="10,2">
                                <TextBlock x:Name="VersionText"
                                           Foreground="{DynamicResource AppPrimary}"
                                           FontSize="{DynamicResource SettingsCaptionSize}"
                                           AutomationProperties.AutomationId="AboutVersion" />
                            </Border>
                            <TextBlock Text="{x:Static res:Strings.AboutLicense}"
                                       Style="{DynamicResource SettingsHintStyle}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource AppDivider}" Margin="0,16,0,14" />

                    <TextBlock Text="{x:Static res:Strings.AboutDescription}"
                               TextWrapping="Wrap"
                               LineHeight="20" />
                </StackPanel>
            </Border>

            <!-- The project page. -->
            <Border Style="{DynamicResource SettingsGroupCardStyle}" Padding="16,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE774;"
                               FontFamily="{DynamicResource AppIconFontFamily}"
                               FontSize="16"
                               Foreground="{DynamicResource AppPrimary}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock>
                            <Hyperlink x:Name="ProjectLink"
                                       RequestNavigate="OnProjectLinkRequestNavigate"
                                       AutomationProperties.AutomationId="AboutProjectLink">
                                <Run x:Name="ProjectLinkText" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The update check: a button and what came of it. -->
            <StackPanel x:Name="UpdateCard">
                <Border Style="{DynamicResource SettingsGroupCardStyle}" Padding="16,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;"
                                       FontFamily="{DynamicResource AppIconFontFamily}"
                                       FontSize="16"
                                       Foreground="{DynamicResource AppPrimary}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <Button x:Name="CheckUpdatesButton"
                                    Content="{x:Static res:Strings.AboutCheckUpdates}"
                                    Click="OnCheckUpdatesClick"
                                    Padding="18,3"
                                    MinHeight="32"
                                    AutomationProperties.AutomationId="AboutCheckUpdatesButton" />
                        </StackPanel>
                        <TextBlock x:Name="UpdateStatusText"
                                   TextWrapping="Wrap"
                                   Style="{DynamicResource SecondaryTextStyle}"
                                   Margin="26,8,0,0"
                                   AutomationProperties.AutomationId="AboutUpdateStatus" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
