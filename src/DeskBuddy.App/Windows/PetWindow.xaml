<Window x:Class="DeskBuddy.App.Windows.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskBuddy"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <!-- AllowsTransparency=False + glass over the whole window gives hardware-accelerated per-pixel alpha.
         Click-through for transparent pixels is done in code via WM_NCHITTEST. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="-1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <!-- Skin art faces right; FlipTransform mirrors it when the pet walks left. The frame size in the manifest is the
         size on screen; the PNG frames are scaled to it, so they can have more pixels for sharpness. -->
    <Image x:Name="SpriteImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
        <Image.RenderTransform>
            <ScaleTransform x:Name="FlipTransform" ScaleX="1" ScaleY="1" />
        </Image.RenderTransform>
    </Image>
</Window>
