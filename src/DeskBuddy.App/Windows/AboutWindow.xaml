<Window x:Class="DeskBuddy.App.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:DeskBuddy.App.Resources"
        Title="{x:Static res:Strings.AboutTitle}"
        Icon="pack://application:,,,/DeskBuddy;component/Assets/DeskBuddy.ico"
        Width="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DeskBuddy;component/Themes/SecondaryText.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="24,20,24,20">
        <!-- The picture is set in code: an Image given an .ico shows its first (16 pixel) frame, scaled up and blurry. -->
        <Image x:Name="LogoImage"
               Width="64"
               Height="64"
               HorizontalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock Text="{x:Static res:Strings.AppName}"
                   FontSize="20"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0" />
        <TextBlock x:Name="VersionText"
                   HorizontalAlignment="Center"
                   Style="{StaticResource SecondaryTextStyle}"
                   Margin="0,2,0,0"
                   AutomationProperties.AutomationId="AboutVersion" />
        <TextBlock Text="{x:Static res:Strings.AboutDescription}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="0,14,0,0" />
        <TextBlock HorizontalAlignment="Center" Margin="0,14,0,0">
            <Hyperlink x:Name="ProjectLink"
                       RequestNavigate="OnProjectLinkRequestNavigate"
                       AutomationProperties.AutomationId="AboutProjectLink">
                <Run Text="{x:Static res:Strings.AboutProjectPage}" />
            </Hyperlink>
        </TextBlock>
        <TextBlock Text="{x:Static res:Strings.AboutLicense}"
                   HorizontalAlignment="Center"
                   Style="{StaticResource SecondaryTextStyle}"
                   FontSize="11"
                   Margin="0,6,0,0" />
        <StackPanel x:Name="UpdatePanel" Margin="0,14,0,0">
            <Button x:Name="CheckUpdatesButton"
                    Content="{x:Static res:Strings.AboutCheckUpdates}"
                    Click="OnCheckUpdatesClick"
                    HorizontalAlignment="Center"
                    Padding="16,4"
                    AutomationProperties.AutomationId="AboutCheckUpdatesButton" />
            <TextBlock x:Name="UpdateStatusText"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Style="{StaticResource SecondaryTextStyle}"
                       Margin="0,6,0,0"
                       AutomationProperties.AutomationId="AboutUpdateStatus" />
        </StackPanel>
        <Button x:Name="CloseButton"
                Content="{x:Static res:Strings.AboutClose}"
                IsCancel="True"
                IsDefault="True"
                Click="OnCloseClick"
                HorizontalAlignment="Center"
                Padding="28,4"
                Margin="0,18,0,0"
                AutomationProperties.AutomationId="AboutCloseButton" />
    </StackPanel>
</Window>
