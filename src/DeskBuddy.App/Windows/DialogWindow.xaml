<Window x:Class="DeskBuddy.App.Windows.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{DynamicResource DialogWindowStyle}"
        Padding="0"
        Icon="pack://application:,,,/DeskBuddy;component/Assets/DeskBuddy.ico"
        MinWidth="340"
        MaxWidth="460"
        SizeToContent="WidthAndHeight"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- The answers, on a slightly different surface as in a Windows 11 dialog. -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource AppSurface}"
                BorderBrush="{DynamicResource AppDivider}"
                BorderThickness="0,1,0,0"
                Padding="20,14">
            <StackPanel x:Name="ButtonPanel" Orientation="Horizontal" HorizontalAlignment="Right" />
        </Border>

        <Grid Margin="24,22,24,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="IconText"
                       Grid.Column="0"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="30"
                       VerticalAlignment="Top"
                       Margin="0,0,16,0"
                       Foreground="{DynamicResource AppPrimary}"
                       AutomationProperties.AutomationId="DialogIcon" />
            <TextBlock x:Name="MessageText"
                       Grid.Column="1"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       AutomationProperties.AutomationId="DialogMessage" />
        </Grid>
    </DockPanel>
</Window>
