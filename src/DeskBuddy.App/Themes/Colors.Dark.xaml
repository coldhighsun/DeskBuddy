<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The colors of the application, dark theme: blue-black with a bright blue accent. The keys are the same in
         Colors.Light.xaml and Colors.HighContrast.xaml; keep the three files in step by hand. Every color is read through a
         DynamicResource, so a change of theme takes effect at once. -->
    <SolidColorBrush x:Key="AppPrimary" Color="#FF4F8DF7" />
    <SolidColorBrush x:Key="AppPrimaryDark" Color="#FF3A74DB" />
    <SolidColorBrush x:Key="AppPrimarySoft" Color="#334F8DF7" />
    <SolidColorBrush x:Key="AppPrimaryForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AppForeground" Color="#FFE7E9EE" />
    <SolidColorBrush x:Key="AppForegroundMuted" Color="#FF8D95A6" />
    <SolidColorBrush x:Key="AppBackground" Color="#FF12141A" />
    <SolidColorBrush x:Key="AppSurface" Color="#FF212530" />
    <SolidColorBrush x:Key="AppDivider" Color="#FF363C4B" />
    <SolidColorBrush x:Key="AppBarBackground" Color="#FF12141A" />
    <SolidColorBrush x:Key="AppBarForeground" Color="#FFE7E9EE" />
    <SolidColorBrush x:Key="AppHover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="AppPressed" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="AppWarning" Color="#FFF0B04A" />
    <SolidColorBrush x:Key="AppWarningSoft" Color="#33F0B04A" />
    <SolidColorBrush x:Key="AppSuccess" Color="#FF43C77D" />
    <SolidColorBrush x:Key="AppSuccessSoft" Color="#3343C77D" />
    <SolidColorBrush x:Key="AppDanger" Color="#FFFF6B6B" />
    <SolidColorBrush x:Key="AppDangerSoft" Color="#33FF6B6B" />
    <SolidColorBrush x:Key="AppInfo" Color="#FF3CC4DD" />
    <SolidColorBrush x:Key="AppInfoSoft" Color="#333CC4DD" />
    <SolidColorBrush x:Key="AppCloseHover" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="AppClosePressed" Color="#FFA02317" />
    <SolidColorBrush x:Key="AppCloseForeground" Color="#FFFFFFFF" />
</ResourceDictionary>
