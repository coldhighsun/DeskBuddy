<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Colors DeskBuddy draws itself; the standard controls take their colors from the WPF theme. Key names must not
         collide with the Fluent theme resources (see ThemeResourcesTests), which win inside themed windows. -->
    <SolidColorBrush x:Key="BubbleBackgroundBrush" Color="#FF2E2620" />
    <SolidColorBrush x:Key="BubbleBorderBrush" Color="#FF5A4838" />
    <SolidColorBrush x:Key="BubbleTextBrush" Color="#FFF3E6D8" />
    <SolidColorBrush x:Key="BubbleButtonBackgroundBrush" Color="#FF3F342C" />
    <SolidColorBrush x:Key="BubbleButtonHoverBrush" Color="#FF4D4036" />
    <SolidColorBrush x:Key="BubbleButtonPressedBrush" Color="#FF5A4838" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#FFFF99A4" />
    <SolidColorBrush x:Key="PetCardBorderBrush" Color="#FF7A7A7A" />
    <SolidColorBrush x:Key="PetCardSelectedBorderBrush" Color="#FF60CDFF" />
</ResourceDictionary>
