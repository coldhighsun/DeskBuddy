<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Colors DeskBuddy draws itself; the standard controls take their colors from the WPF theme. Key names must not
         collide with the Fluent theme resources (see ThemeResourcesTests), which win inside themed windows. -->
    <SolidColorBrush x:Key="BubbleBackgroundBrush" Color="#FFFDF6EC" />
    <SolidColorBrush x:Key="BubbleBorderBrush" Color="#FFE0C8A8" />
    <SolidColorBrush x:Key="BubbleTextBrush" Color="#FF3C281E" />
    <SolidColorBrush x:Key="BubbleButtonBackgroundBrush" Color="#FFF3E3CC" />
    <SolidColorBrush x:Key="BubbleButtonHoverBrush" Color="#FFEBD3B3" />
    <SolidColorBrush x:Key="BubbleButtonPressedBrush" Color="#FFE0C8A8" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#FFD13438" />
    <SolidColorBrush x:Key="PetCardBorderBrush" Color="#FFA8A8A8" />
    <SolidColorBrush x:Key="PetCardSelectedBorderBrush" Color="#FF0067C0" />
</ResourceDictionary>
