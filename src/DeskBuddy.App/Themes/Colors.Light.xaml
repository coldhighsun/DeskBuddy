<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The colors of the application, light theme: cool grey with white cards and a blue accent. The keys are the same in
         Colors.Dark.xaml and Colors.HighContrast.xaml; keep the three files in step by hand. Every color is read through a
         DynamicResource, so a change of theme takes effect at once. -->
    <SolidColorBrush x:Key="AppPrimary" Color="#FF2B6CF0" />
    <SolidColorBrush x:Key="AppPrimaryDark" Color="#FF1F55C4" />
    <SolidColorBrush x:Key="AppPrimarySoft" Color="#1F2B6CF0" />
    <SolidColorBrush x:Key="AppPrimaryForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AppForeground" Color="#FF1B1E27" />
    <SolidColorBrush x:Key="AppForegroundMuted" Color="#FF5F6676" />
    <SolidColorBrush x:Key="AppBackground" Color="#FFF2F4F8" />
    <SolidColorBrush x:Key="AppSurface" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AppDivider" Color="#FFC5CCD9" />
    <SolidColorBrush x:Key="AppBarBackground" Color="#FFF2F4F8" />
    <SolidColorBrush x:Key="AppBarForeground" Color="#FF1B1E27" />
    <SolidColorBrush x:Key="AppHover" Color="#17000000" />
    <SolidColorBrush x:Key="AppPressed" Color="#2E000000" />
    <SolidColorBrush x:Key="AppWarning" Color="#FFB26A00" />
    <SolidColorBrush x:Key="AppWarningSoft" Color="#26D98200" />
    <SolidColorBrush x:Key="AppSuccess" Color="#FF1E9E5A" />
    <SolidColorBrush x:Key="AppSuccessSoft" Color="#261E9E5A" />
    <SolidColorBrush x:Key="AppDanger" Color="#FFD93838" />
    <SolidColorBrush x:Key="AppDangerSoft" Color="#26D93838" />
    <SolidColorBrush x:Key="AppInfo" Color="#FF0C93B0" />
    <SolidColorBrush x:Key="AppInfoSoft" Color="#260C93B0" />
    <SolidColorBrush x:Key="AppCloseHover" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="AppClosePressed" Color="#FFA02317" />
    <SolidColorBrush x:Key="AppCloseForeground" Color="#FFFFFFFF" />
</ResourceDictionary>
