<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:interop="clr-namespace:DeskBuddy.App.Interop"
                    xmlns:pres="clr-namespace:DeskBuddy.App.Presentation">
    <!-- The look of DeskBuddy's windows, menus and controls, drawn by the application itself (no WPF Fluent theme). The
         design follows ManagedDrive: borderless windows with a 48 px title bar, rounded corners from DWM, flat controls and
         a blue accent. Every color is a DynamicResource from Colors.{Light,Dark,HighContrast}.xaml, so a change of theme
         takes effect at once. The pet, umbrella and bubble windows are transparent and do not use the window styles here. -->

    <!-- ========== Shape tokens ========== -->
    <CornerRadius x:Key="ButtonCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="SectionCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="PopupCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="SettingsCardRadius">12</CornerRadius>
    <CornerRadius x:Key="SettingsPillRadius">10</CornerRadius>

    <!-- ========== Type scale ========== -->
    <sys:Double x:Key="FontSizeDisplay">22</sys:Double>
    <sys:Double x:Key="FontSizeTitle">16</sys:Double>
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeSmall">11</sys:Double>
    <sys:Double x:Key="SettingsCaptionSize">11</sys:Double>
    <!-- Not Segoe UI Variable: it is a variable font without TrueType hinting, so with TextFormattingMode=Display (pixel-snapped
         GDI-style text) WPF draws it soft. Segoe UI is hinted and stays sharp. -->
    <FontFamily x:Key="AppFontFamily">Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="AppIconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Thickness x:Key="SettingsRowGap">0,8,0,0</Thickness>

    <!-- ========== Text ========== -->
    <Style x:Key="IconText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppIconFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Text in the muted color: explanations, captions. The color is used, not Opacity, to keep ClearType. -->
    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundMuted}" />
    </Style>

    <!-- A short explanation under a control. -->
    <Style x:Key="SettingsHintStyle" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource SettingsCaptionSize}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!-- The small heading on the first line of a group of settings. -->
    <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundMuted}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource AppPrimary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AppPrimaryDark}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ========== Windows ========== -->
    <Style x:Key="AppWindow" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppForeground}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!-- The base of every window that draws its own chrome: no system frame; the rounded corners, border and shadow come
         from DWM (WindowCornerHelper). Never AllowsTransparency or a self-drawn rounded Border on such a window, which
         leaves seams in the corners. -->
    <Style x:Key="BorderlessWindowStyle" TargetType="Window" BasedOn="{StaticResource AppWindow}">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="interop:WindowCornerHelper.UseNativeCorners" Value="True" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="48"
                              ResizeBorderThickness="0"
                              GlassFrameThickness="0"
                              NonClientFrameEdges="None"
                              UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Buttons ========== -->
    <Style x:Key="IconButtonFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="1" RadiusX="6" RadiusY="6" Stroke="{DynamicResource AppPrimary}" StrokeThickness="2" IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A square toolbar button holding a glyph. -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource IconButtonFocusVisual}" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource AppBarForeground}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ButtonCornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Set on the button, not on Bd, so that a style based on this one (CloseIconButton) can change them. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AppHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AppPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The close button of a window: it turns red under the mouse. -->
    <Style x:Key="CloseIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AppCloseHover}" />
                <Setter Property="Foreground" Value="{DynamicResource AppCloseForeground}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource AppClosePressed}" />
                <Setter Property="Foreground" Value="{DynamicResource AppCloseForeground}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Text only, no background. -->
    <Style x:Key="FlatButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource AppPrimary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ButtonCornerRadius}"
                            BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppPressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AppPrimary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The primary action: filled with the accent color. -->
    <Style x:Key="RaisedButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource AppPrimary}" />
        <Setter Property="Foreground" Value="{DynamicResource AppPrimaryForeground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ButtonCornerRadius}"
                            BorderBrush="{DynamicResource AppPrimaryForeground}" BorderThickness="0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppPrimaryDark}" />
                        </Trigger>
                        <!-- Pressed is the hover shade a step fainter, so the two states differ in every palette. -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppPrimaryDark}" />
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                            <Setter TargetName="Bd" Property="Padding" Value="15,5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The look of a plain Button: an outline. Every button without a style of its own gets it. -->
    <Style x:Key="OutlinedButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppDivider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ButtonCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppPressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AppPrimary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource OutlinedButton}" />

    <!-- ========== Dialog window: borderless, with a 48 px title bar ========== -->
    <!-- Corners, border and shadow come from BorderlessWindowStyle: on Windows 11 DWM draws them; on Windows 10 it cannot, so
         WindowCornerHelper gives the window a 1 px BorderBrush/BorderThickness, which the TemplateBinding of those two
         properties on the outer Border draws. Do not remove them. The Padding of the window is the margin of its content
         (24 unless a window sets its own). WindowStartupLocation is no dependency property, so each window sets it itself. -->
    <Style x:Key="DialogWindowStyle" TargetType="Window" BasedOn="{StaticResource BorderlessWindowStyle}">
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border Background="{DynamicResource AppBackground}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="{DynamicResource AppBarBackground}" Height="48" Padding="14,0,4,0">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource CloseIconButton}"
                                            Command="{x:Static pres:WindowCommands.Close}"
                                            WindowChrome.IsHitTestVisibleInChrome="True"
                                            AutomationProperties.AutomationId="WindowCloseButton">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE711;" />
                                    </Button>
                                    <Button x:Name="MinimizeButton"
                                            DockPanel.Dock="Right"
                                            Visibility="Collapsed"
                                            Style="{StaticResource IconButton}"
                                            Command="{x:Static pres:WindowCommands.Minimize}"
                                            WindowChrome.IsHitTestVisibleInChrome="True"
                                            AutomationProperties.AutomationId="WindowMinimizeButton">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE921;" />
                                    </Button>
                                    <Image DockPanel.Dock="Left"
                                           Width="18"
                                           Height="18"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"
                                           Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource AppBarForeground}"
                                               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </DockPanel>
                            </Border>
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Only a window that can be minimized gets the button. -->
                        <Trigger Property="ResizeMode" Value="CanMinimize">
                            <Setter TargetName="MinimizeButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Progress bar: a rounded track with a filled part. Only the determinate bar is drawn; a download whose
         size is unknown leaves it empty and says how much has arrived in the text next to it. ========== -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource AppPrimary}" />
        <Setter Property="Background" Value="{DynamicResource AppPrimarySoft}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3" />
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="3" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Groups, cards and chips ========== -->
    <!-- A bordered group of related settings; the next group sits 12 below it. -->
    <Style x:Key="SettingsGroupStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppDivider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource SectionCornerRadius}" />
        <Setter Property="Padding" Value="14,12,14,14" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="SettingsGroupCardStyle" TargetType="Border" BasedOn="{StaticResource SettingsGroupStyle}" />

    <!-- The frame of a selectable card (a pet, a pet size). -->
    <Style x:Key="SettingsCardBorderStyle" TargetType="Border">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SettingsCardRadius}" />
        <Setter Property="Background" Value="{DynamicResource AppSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppDivider}" />
    </Style>

    <!-- A small rounded label, such as a capability of a pet. -->
    <Style x:Key="SettingsChipBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource SettingsPillRadius}" />
        <Setter Property="Background" Value="{DynamicResource AppPrimarySoft}" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- ========== Text boxes, combo boxes, check boxes ========== -->
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppDivider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AppForeground}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AppPrimary}" />
        <Setter Property="SelectionTextBrush" Value="{DynamicResource AppPrimaryForeground}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ButtonCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AppPrimary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The rows of a drop-down list follow the palette (the default draws the system's blue selection). -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            CornerRadius="{DynamicResource ButtonCornerRadius}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppPrimarySoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A custom template so that the drop-down itself follows the theme (the native popup is always white). -->
    <Style TargetType="ComboBox">
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppDivider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleBtn"
                                      Background="{TemplateBinding Background}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"
                                      Focusable="False">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Frame" Background="{TemplateBinding Background}"
                                            BorderBrush="{DynamicResource AppDivider}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{DynamicResource ButtonCornerRadius}" />
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource AppHover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Grid Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="{StaticResource AppIconFontFamily}" FontSize="10"
                                       Foreground="{DynamicResource AppForegroundMuted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{DynamicResource AppSurface}"
                                    BorderBrush="{DynamicResource AppDivider}"
                                    BorderThickness="1" CornerRadius="{DynamicResource PopupCornerRadius}" Padding="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="240" Margin="0,0,8,8">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="1" BlurRadius="8" Opacity="0.25" />
                                </Border.Effect>
                                <ScrollViewer SnapsToDevicePixels="True" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ToggleBtn" Property="BorderBrush" Value="{DynamicResource AppPrimary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Radio buttons have their own templates where they are used; this gives them the text color of the theme. -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <!-- A 16 px rounded square that fills with the accent color and shows a check, the same as in the menus. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Grid.Column="0" Width="16" Height="16" CornerRadius="4" BorderThickness="1"
                                VerticalAlignment="Center"
                                BorderBrush="{DynamicResource AppForegroundMuted}" Background="Transparent">
                            <TextBlock x:Name="Mark" Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="11"
                                       Foreground="{DynamicResource AppPrimaryForeground}" Visibility="Hidden" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AppPrimary}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AppPrimary}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AppPrimary}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AppPrimary}" />
                            <Setter TargetName="Mark" Property="Text" Value="&#xE738;" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AppPrimary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AppPrimary}" />
                            <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Tool tip ========== -->
    <!-- A tool tip opens in its own popup and does not inherit the window's font. -->
    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="Background" Value="{DynamicResource AppSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppDivider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <!-- ========== Menus ========== -->
    <!-- Implicit styles, so that every context menu of the application follows the theme: the native popup is always white. The
         shadow needs room, which the margin gives it. -->
    <Style TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{DynamicResource AppSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppDivider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            Margin="0,0,8,8"
                            CornerRadius="{DynamicResource PopupCornerRadius}">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="1" BlurRadius="8" Opacity="0.25" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The columns are: check (only for a checked item), icon (only for an item that has one), text, submenu arrow.
         PART_Popup, SubmenuBorder and SubmenuScroll are looked up by TrayIconService.AlignSubmenu. -->
    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                CornerRadius="{DynamicResource ButtonCornerRadius}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="CheckColumn" Width="0" />
                                    <ColumnDefinition x:Name="IconColumn" Width="Auto" />
                                    <ColumnDefinition x:Name="HeaderColumn" Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CheckBox" Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0"
                                        CornerRadius="4" BorderThickness="1" VerticalAlignment="Center"
                                        BorderBrush="{DynamicResource AppForegroundMuted}" Background="Transparent"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="CheckMark" Text="&#xE73E;" Style="{StaticResource IconText}"
                                               FontSize="11" Foreground="{DynamicResource AppPrimaryForeground}"
                                               Visibility="Hidden" />
                                </Border>
                                <ContentPresenter x:Name="Icon" Grid.Column="1" ContentSource="Icon" Margin="0,0,10,0"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <ContentPresenter Grid.Column="2" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                                <TextBlock x:Name="SubmenuArrow" Grid.Column="3" Text="&#xE76C;" Style="{StaticResource IconText}"
                                           FontSize="10" Margin="16,0,0,0" Foreground="{DynamicResource AppForegroundMuted}"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-2" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border x:Name="SubmenuBorder"
                                    Background="{DynamicResource AppSurface}"
                                    BorderBrush="{DynamicResource AppDivider}"
                                    BorderThickness="1" Padding="4" CornerRadius="{DynamicResource PopupCornerRadius}" Margin="0,0,8,8">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="1" BlurRadius="8" Opacity="0.25" />
                                </Border.Effect>
                                <!-- No height limit unless TrayIconService.AlignSubmenu is given one (the pet grid). -->
                                <ScrollViewer x:Name="SubmenuScroll" CanContentScroll="False" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconColumn" Property="Width" Value="0" />
                        </Trigger>
                        <!-- An item that is only a picture (the pets, the sizes): the picture takes the whole row and is centered. -->
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="IconColumn" Property="Width" Value="*" />
                            <Setter TargetName="HeaderColumn" Property="Width" Value="0" />
                            <Setter TargetName="Icon" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsCheckable" Value="True">
                            <Setter TargetName="CheckColumn" Property="Width" Value="Auto" />
                            <Setter TargetName="CheckBox" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckColumn" Property="Width" Value="Auto" />
                            <Setter TargetName="CheckBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="CheckBox" Property="Background" Value="{DynamicResource AppPrimary}" />
                            <Setter TargetName="CheckBox" Property="BorderBrush" Value="{DynamicResource AppPrimary}" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A separator in a menu is styled through MenuItem.SeparatorStyleKey, so that the built-in style, which leaves room
         for an icon gutter, does not win. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource AppDivider}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}" Height="{TemplateBinding Height}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Scroll bars ========== -->
    <Style x:Key="AppScrollBarThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder" CornerRadius="4" Background="{DynamicResource AppForegroundMuted}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AppPrimary}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AppPrimaryDark}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource AppScrollBarPageButton}" Command="ScrollBar.LineUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource AppScrollBarPageButton}" Command="ScrollBar.LineDownCommand" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource AppScrollBarThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False" Focusable="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource AppScrollBarPageButton}" Command="ScrollBar.LineLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource AppScrollBarPageButton}" Command="ScrollBar.LineRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource AppScrollBarThumb}" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="8" />
                <Setter Property="Height" Value="Auto" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ========== Tabs: titles with an underline under the selected one ========== -->
    <Style x:Key="AppTabItem" TargetType="TabItem">
        <!-- The content of the selected tab inherits its text color from the TabItem, which would otherwise get the black of the system. -->
        <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Background="Transparent">
                        <StackPanel>
                            <ContentPresenter x:Name="Header" ContentSource="Header" Margin="12,8,12,10" HorizontalAlignment="Center"
                                              Opacity="0.72" TextElement.Foreground="{DynamicResource AppForeground}" />
                            <Border x:Name="Indicator" Height="2" Background="Transparent" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource AppPrimary}" />
                            <Setter TargetName="Header" Property="Opacity" Value="1" />
                            <Setter TargetName="Header" Property="TextElement.FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Header" Property="Opacity" Value="1" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppHover}" />
                            <Setter TargetName="Bd" Property="CornerRadius" Value="3,3,0,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource AppTabItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="{DynamicResource AppDivider}" BorderThickness="0,0,0,1" Padding="12,0">
                            <TabPanel IsItemsHost="True" HorizontalAlignment="Left" />
                        </Border>
                        <Border Grid.Row="1" Background="Transparent">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
